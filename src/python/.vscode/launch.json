{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Policy worker",
      "type": "debugpy",
      "request": "launch",
      "module": "app.workers.policy_worker",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Live extraction tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-m", "live", "-v", "tests/test_extraction_live.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
