<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6887863">
  <PropertyGroup>
    <StartupCommand>npm start</StartupCommand>
    <JavaScriptTestRoot>src\</JavaScriptTestRoot>
    <JavaScriptTestFramework>Vitest</JavaScriptTestFramework>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist\benefits-intelligence-web\browser\</BuildOutputFolder>
    <!-- The front end is built with the Angular CLI (and in its own Docker image), so building the
         .NET solution does not require Node. -->
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
  </PropertyGroup>
</Project>
